# ---- database -------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/eval_tinder
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/eval_tinder_test

# ---- models ---------------------------------------------------------------
# "fake" runs the deterministic scripted grader/reflection models (offline demo, tests).
# "litellm" uses the real provider through dspy.LM; set both model ids explicitly.
LLM_PROVIDER=fake
GRADER_MODEL=
REFLECTION_MODEL=
# Provider credentials are read by LiteLLM from the environment, e.g.:
# OPENAI_API_KEY=...
# ANTHROPIC_API_KEY=...

# ---- budgets (application-level; a GEPA metric-call budget is not a token budget)
MAX_PROVIDER_CALLS_PER_JOB=2000
MAX_TOKENS_PER_CALL=16000
MAX_TOTAL_TOKENS_PER_JOB=20000000
# Optional pricing table for cost estimates (JSON): {"openai/gpt-x": {"input_per_1k": 0.001, "output_per_1k": 0.002}}
PRICING_TABLE={}

# ---- storage / security ---------------------------------------------------
ARTIFACT_PATH=./artifacts
# Leave empty only for a single-expert deployment bound to loopback; set for anything else.
API_TOKEN=
REVIEWER_ID=local-expert
LEASE_SECONDS=900
JOB_LEASE_SECONDS=120
